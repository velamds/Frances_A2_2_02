pe": "text"}]}, {"type": "post_question", "contents": {"content": ". ", "type": ""}}, {"content": "secondary_3", "type": "objective"}], "id": 3}], "_data": [{"type": "instructions", "contents": [{"content": " Faisons une visite guid\u00e9e avec Charlotte !", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Quelque chose ne va pas. Essayez encore une fois !", "type": "text"}, {"content": "La prochaine fois peut-\u00eatre...", "type": "text"}], "correct_feedback": "Parfait !", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Appuyez sur la liste d\u00e9roulante. Choisissez la bonne r\u00e9ponse.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "", "coverimg": "", "images": [{"image": "", "text": "", "time": "0", "id": 0}, {"image": "", "text": "Late fall in Moscow is cold. Bring a warm coat! The Kremlin stands in the center of the city of Moscow. It is high on a hill, beside the Moskova river. It is one of the most important historical places in the world.The original building was a fortress. Why did they build the walls thick? These walls surrounded the fortress and protected the Russian princes. You can walk around all 1.3 miles!", "time": "", "id": 1}, {"image": "", "text": "Inside the Kremlin today the tour took me into the Great Hall. The room had a polished wood floor with cream walls. Here and there were accents of deep aqua. The gilded doors, and other woodwork  flashed in the light from the crystal chandeliers. The elegant space made me think of fairy tales.", "time": "", "id": 2}]}}], "_data": []}, {"template_override": 1, "type": "video", "id": 2, "title": "", "contents": [{"type": "video", "value": {"video_src": "frn5le02ob01re2vid01", "images": [{"image": "", "text": "", "time": "0", "id": 0}, {"image": "", "text": "<span class=\"strong\">La valise de Charlotte </span><br>\nIl fait assez froid \u00e0 la fin d'automne \u00e0 Moscou. Il vaut mieux apporter un manteau d'hiver.<br>", "time": "100", "id": 1}, {"image": "", "text": "Le Kremlin, l'un des monuments historiques les plus c\u00e9l\u00e8bres du monde, est situ\u00e9 au centre-ville de Moscou, sur une colline qui surplombe la Moskova, le fleuve qui sillonne la ville.", "time": "10500", "id": 2}, {"image": "", "text": "Pourquoi est-il entour\u00e9 d'une muraille si \u00e9paisse ? Car le Kremlin \u00e9tait un ch\u00e2teau fort \u00e0 l'origine. Cette enceinte \u00e9tait suppos\u00e9e prot\u00e9ger les princesses russes. Vous pouvez faire un tour complet \u00e0 pied de la forteresse, dont la longueur n'est pas plus de 2 km !", "time": "25000", "id": 3}, {"image": "", "text": "Lors de la visite guid\u00e9e du Kremlin, on m'a fait voir le hall principal. La salle arbore une couleur cr\u00e8me fonc\u00e9e aux murs et un joli parquet de ch\u00eane cir\u00e9 au sol. Dans le vestibule, la couleur bleue pr\u00e9domine. Les portes dor\u00e9es, de magnifiques ouvrages d'\u00e9b\u00e9nisterie, se voient refl\u00e9t\u00e9es dans les immenses lustres en cristal. Ce beau d\u00e9cor luxueux m'a rappel\u00e9 les contes de f\u00e9es de mon enfance.", "time": "42000", "id": 4}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Charlotte en Russie", "type": "lesson_name"}, {"content": "Une visite du Kremlin", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "scholar > Famous Structures > The Kremlin", "type": "origin"}, {"content": 2, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant d\u00e9crit en fran\u00e7ais \u00e9crit et oral des pi\u00e8ces, des maisons et des objets des immeubles dans des situations sociales quotidiennes ou de travail.", "type": "primary"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_1"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_2"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_3"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_4"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_5"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_6"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_7"}, {"content": "Demander ou rapporter des informations sur des choses, des actions, des \u00e9v\u00e9nements.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "La place de l'adjectif qualificatif", "type": "heading"}, {"content": "L'adjectif</span> est un mot ajout\u00e9 \u00e0 un nom (ou \u00e0 un pronom) pour lui apporter un compl\u00e9ment d'information sur sa qualit\u00e9, sa propri\u00e9t\u00e9 ou son \u00e9tat (grandeur, couleur, forme, etc.).", "type": "describer"}, {"content": "<span class=\"strong\">La place des adjectifs qualificatifs</span>", "type": "text"}, {"content": "<li> La plupart des adjectifs qualificatifs en fran\u00e7ais se placent apr\u00e8s le nom :</br><br/>Exemples : </br> <span class=\"italic\">Charlotte est une fille <span class=\"strong\">riche</span>. </br> Elle a visit\u00e9 plusieurs pays <span class=\"strong\">europ\u00e9ens</span>. </br> Elle porte un manteau <span class=\"strong\">chaud</span> avec des bottes <span class=\"strong\">noires</span>.", "type": "text"}, {"content": "<li> Il y a des adjectifs qui se placent avant les noms ; notamment les adjectifs courts qui sont utilis\u00e9s couramment (petit, gros, grand, etc.) ou bien ceux qui permettent une appr\u00e9ciation g\u00e9n\u00e9rale (beau, bon, gentil, etc.)</br><br/>Exemples :  </br><span class=\"italic\">Paris est une <span class=\"strong\">grande</span> ville. </br> Jacques est un <span class=\"strong\">gentil</span> gar\u00e7on.</br> Marc est devenu un <span class=\"strong\">vieil</span> homme.</br> Sarah est une <span class=\"strong\">jeune</span> fille <span class=\"strong\">intelligente</span>. </br>", "type": "text"}, {"content": " ", "type": "text"}, {"content": "J'ai une <span class=\"strong\">jolie</span> maison. ", "type": "example"}, {"content": "C'est ma <span class=\"strong\">meilleure</span> copine.", "type": "example"}, {"content": "Il ach\u00e8te une  <span class=\"strong\">deuxi\u00e8me</span> voiture.</span>", "type": "example"}, {"content": "Moscou est une <span class=\"strong\">belle</span> ville. ", "type": "example"}, {"content": "Moscou a un maire <span class=\"strong\">efficace</span>", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Salle, chambre, pi\u00e8ce", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "Charlotte a un grand appartement qui a trois chambres, une salle \u00e0 manger, une salle de s\u00e9jour et deux salles de bain.   ", "type": "example"}, {"content": "<li>Tout espace \u00e0 l'int\u00e9rieur d'une maison, d'un appartement ou d'un bureau qui est s\u00e9par\u00e9 et d\u00e9limit\u00e9 par des murs constitue une <span class=\"strong\">pi\u00e8ce</span>. ", "type": "text"}, {"content": "<li>Une <span class=\"strong\">salle</span> est une grande pi\u00e8ce dans une maison, un appartement ou un bureau o\u00f9 se passent la plupart des activit\u00e9s quotidiennes des individus. Ce mot est souvent accompagn\u00e9 d'une partie explicative : <span class=\"italic\">salle \u00e0 manger, salle de s\u00e9jour, salle de classe, </span>etc.", "type": "text"}, {"content": "<li>Une <span class=\"strong\">chambre</span> est une pi\u00e8ce plus petite et priv\u00e9e dans un appartement ou une maison qu'on utilise surtout pour dormir. La forme plus longue de ce mot est <span class=\"italic\"> \u00ab chambre \u00e0 coucher&nbsp;\u00bb</span>.", "type": "text"}, {"content": "Cette pi\u00e8ce est grande. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "le vestibule ", "type": "name"}, {"content": "entr\u00e9e d'un \u00e9difice ", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Les murs sont bleus dans le vestibule du ch\u00e2teau. ", "type": "example"}, {"content": "frn5le02ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous pouvez employer pour parler des monuments historiques.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "arborer ", "type": "name"}, {"content": "afficher, montrer, avoir un trait particulier", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : La salle arbore une couleur cr\u00e8me fonc\u00e9e aux murs.", "type": "example"}, {"content": "frn5le02ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le sol ", "type": "name"}, {"content": "surface sous les pieds", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Il y a un parquet au sol.", "type": "example"}, {"content": "frn5le02ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le lustre ", "type": "name"}, {"content": "appareil d'\u00e9clairage accroch\u00e9 au plafond ", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : J'aime les immenses lustres en cristal dans cette salle.", "type": "example"}, {"content": "frn5le02ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le conte de f\u00e9es ", "type": "name"}, {"content": "histoire merveilleuse dont les personnages sont magiques", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Ce beau d\u00e9cor m'a rappel\u00e9 les contes de f\u00e9es de mon enfance.", "type": "example"}, {"content": "frn5le02ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la muraille ", "type": "name"}, {"content": "mur \u00e9pais et \u00e9lev\u00e9", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Pourquoi est-il entour\u00e9 d'une muraille si \u00e9paisse ? ", "type": "example"}, {"content": "frn5le02ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "l'enceinte ", "type": "name"}, {"content": "mur qui entoure et cl\u00f4ture un espace", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Cette enceinte \u00e9tait suppos\u00e9e prot\u00e9ger les princes. ", "type": "example"}, {"content": "frn5le02ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "\u00e9pais, \u00e9paisse ", "type": "name"}, {"content": "qui a de l'\u00e9paisseur", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Les murs ne sont pas \u00e9pais et nous entendons les voisins.", "type": "example"}, {"content": "frn5le02ob01aud09", "type": "audio"}]}, {"content": "frn5le02ob01re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "D'apr\u00e8s la lecture de la page 2, trouvez des endroits touristiques \u00e0 Moscou.", "type": "text"}, {"content": "\u00c9crivez le nom de ces endroits et d\u00e9crivez ce qui s'y trouve.", "type": "text"}, {"content": "Exprimez pourquoi vous voulez aller voir ces endroits.", "type": "text"}, {"content": "Lisez vos phrases \u00e0 voix haute avec votre camarade.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "Je parle des endroits touristiques \u00e0 Moscou.", "type": "text"}, {"content": "Je d\u00e9cris des endroits et des objets d'un logement.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "l'\u00e9b\u00e9nisterie", "type": "name"}, {"content": "travail effectu\u00e9 par un \u00e9b\u00e9niste ", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Les portes dor\u00e9es, de magnifiques ouvrages d'\u00e9b\u00e9nisterie, se voient refl\u00e9ter dans les immenses lustres en cristal.", "type": "example"}, {"content": "frn5le02ob01aud08", "type": "audio"}]}]}